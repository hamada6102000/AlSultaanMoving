<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Ship the migrated content with the build/publish output so it is always found. -->
  <ItemGroup>
    <Content Update="App_Data\content.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
