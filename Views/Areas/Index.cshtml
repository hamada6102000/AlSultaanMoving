@model SiteContent
@{
    ViewData["Title"] = "مناطق خدمة نقل العفش في الرياض";
    ViewData["Description"] = "نغطي شمال ووسط وشرق وغرب وجنوب الرياض: الياسمين والنرجس والملقا والعليا والروضة والعقيق وغيرها. فريق نقل عفش يصل إلى حيّك على مدار الساعة.";
    var site = Model.Site;

    // Link each region and neighborhood to the posts written about it, matched on the
    // post title so a new neighborhood post is picked up without touching this view.
    // A list of bare names gave Google nothing to index; the links make this page the
    // hub for the location posts and pass authority down to them.
    BlogPost? PostFor(string hood) =>
        Model.Blog.FirstOrDefault(p => p.Title.Contains("حي " + hood));
    List<BlogPost> PostsFor(string region) =>
        Model.Blog.Where(p => p.Title.Contains(region)).ToList();
}

<section class="page-hero">
    <div class="container">
        <h1>مناطق الخدمة</h1>
        <div class="breadcrumb-c">
            <a asp-controller="Home" asp-action="Index">الرئيسية</a> <span>/</span> <span>مناطق الخدمة</span>
        </div>
    </div>
</section>

<section class="section bg-white">
    <div class="container">
        <div class="section-head">
            <span class="section-eyebrow">تغطية شاملة</span>
            <h2>نخدم جميع أحياء الرياض</h2>
            <p>فريقنا ينتشر في كل مناطق الرياض ليصل إليك أينما كنت وبأسرع وقت</p>
        </div>
        <div class="row g-4">
            @foreach (var a in Model.Areas)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="area-card">
                        <h4><i class="fa-solid @a.Icon"></i> @a.Region</h4>
                        <ul class="hood-list">
                            @foreach (var h in a.Neighborhoods)
                            {
                                var hoodPost = PostFor(h);
                                if (hoodPost is null)
                                {
                                    <li>@h</li>
                                }
                                else
                                {
                                    <li class="has-post"><a asp-controller="Blog" asp-action="Post" asp-route-slug="@hoodPost.Slug" title="@hoodPost.Title">@h</a></li>
                                }
                            }
                        </ul>
                        @{ var regionPosts = PostsFor(a.Region); }
                        @if (regionPosts.Any())
                        {
                            <ul class="area-posts">
                                @foreach (var p in regionPosts)
                                {
                                    <li><a asp-controller="Blog" asp-action="Post" asp-route-slug="@p.Slug"><i class="fa-solid fa-file-lines"></i> @p.Title</a></li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            }
        </div>
        <p class="text-center text-muted mt-4">لم تجد حيّك في القائمة؟ لا تقلق — نخدم كل أحياء الرياض. تواصل معنا للتأكد.</p>
    </div>
</section>

<section class="cta-band">
    <div class="container">
        <h2>اطلب خدمة نقل العفش في حيّك الآن</h2>
        <p>تغطية سريعة لكل مناطق الرياض على مدار الساعة</p>
        <a href="tel:@site.PhoneIntl" class="btn btn-dark-c btn-lg"><i class="fa-solid fa-phone-volume"></i> @site.Phone</a>
    </div>
</section>
