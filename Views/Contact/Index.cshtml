@model ContactViewModel
@inject IContentRepository Repo
@{
    ViewData["TitleFull"] = "تواصل معنا — طلب عرض سعر نقل عفش | النور";
    ViewData["Description"] = "اتصل بشركة النور لنقل العفش بالرياض على 0543962814 أو راسلنا على واتساب للحصول على عرض سعر مجاني لنقل أثاثك. خدمة على مدار الساعة طوال أيام الأسبوع.";
    var site = Repo.Site;
}

<section class="page-hero">
    <div class="container">
        <h1>تواصل معنا</h1>
        <div class="breadcrumb-c">
            <a asp-controller="Home" asp-action="Index">الرئيسية</a> <span>/</span> <span>تواصل معنا</span>
        </div>
    </div>
</section>

<section class="section bg-white">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-5">
                <span class="section-eyebrow">نحن هنا لخدمتك</span>
                <h2 class="mb-3">تواصل معنا في أي وقت</h2>
                <p style="color:var(--muted)">فريقنا جاهز للرد على استفساراتك وتقديم عرض سعر مجاني على مدار الساعة طوال أيام الأسبوع.</p>

                <div class="d-flex align-items-center gap-3 mb-3 mt-4">
                    <div class="feature-ico" style="margin:0;width:52px;height:52px;font-size:1.3rem"><i class="fa-solid fa-phone"></i></div>
                    <div><small class="text-muted d-block">اتصل بنا</small><a href="tel:@site.PhoneIntl" style="font-weight:800;font-size:1.15rem">@site.Phone</a></div>
                </div>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="feature-ico" style="margin:0;width:52px;height:52px;font-size:1.3rem;background:#e6f7ec;color:var(--whatsapp)"><i class="fa-brands fa-whatsapp"></i></div>
                    <div><small class="text-muted d-block">واتساب</small><a href="https://wa.me/@site.Whatsapp" target="_blank" rel="noopener" style="font-weight:800;font-size:1.15rem">@site.Phone</a></div>
                </div>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="feature-ico" style="margin:0;width:52px;height:52px;font-size:1.3rem"><i class="fa-regular fa-envelope"></i></div>
                    <div><small class="text-muted d-block">البريد الإلكتروني</small><a href="mailto:@site.Email" style="font-weight:800">@site.Email</a></div>
                </div>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="feature-ico" style="margin:0;width:52px;height:52px;font-size:1.3rem"><i class="fa-solid fa-location-dot"></i></div>
                    <div><small class="text-muted d-block">الموقع</small><span style="font-weight:800">@site.City، @site.Country</span></div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="feature-ico" style="margin:0;width:52px;height:52px;font-size:1.3rem"><i class="fa-regular fa-clock"></i></div>
                    <div><small class="text-muted d-block">ساعات العمل</small><span style="font-weight:800">@site.Hours</span></div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="booking-card">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success"><i class="fa-solid fa-circle-check"></i> @TempData["Success"]</div>
                    }
                    <h3><i class="fa-solid fa-paper-plane"></i> أرسل لنا طلبك</h3>
                    <p class="sub">املأ النموذج وسنعاود الاتصال بك بأسرع وقت بعرض سعر مجاني</p>
                    <partial name="_BookingForm" model="Model.Form" />
                </div>
            </div>
        </div>
    </div>
</section>

