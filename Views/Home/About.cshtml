@model SiteContent
@{
    ViewData["TitleFull"] = "من نحن — شركة النور لنقل العفش والأثاث بالرياض";
    ViewData["Description"] = Model.About.Intro;
    var a = Model.About;
    var site = Model.Site;
}

<section class="page-hero">
    <div class="container">
        <h1>@a.Title</h1>
        <div class="breadcrumb-c">
            <a asp-controller="Home" asp-action="Index">الرئيسية</a> <span>/</span> <span>من نحن</span>
        </div>
    </div>
</section>

<section class="section bg-white">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="section-eyebrow">تعرّف علينا</span>
                <h2>@site.Name</h2>
                <p style="font-size:1.08rem">@a.Intro</p>
                <p>نمتلك خبرة تمتد لأكثر من 10 سنوات في مجال نقل الأثاث داخل الرياض وبين مدن المملكة، اعتمد علينا خلالها أكثر من 1500 عميل. يضمّ فريقنا أكثر من 50 فنياً وعاملاً مدرّباً على أعلى المعايير، مجهزين بأسطول شاحنات حديثة وأدوات متخصصة لضمان نقل أثاثك بأمان تام.</p>
                <div class="row g-3 mt-2">
                    @foreach (var s in site.Stats)
                    {
                        <div class="col-6 col-md-3">
                            <div class="feature-card" style="padding:1.1rem .6rem">
                                <div class="num" style="color:var(--primary);font-size:1.9rem;font-weight:900">@s.Value</div>
                                <div style="color:var(--muted);font-size:.85rem;font-weight:600">@s.Label</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-5">
                <div class="about-visual text-center">
                    <div class="big"><i class="fa-solid fa-truck-ramp-box"></i></div>
                    <h3 style="color:#fff">شريكك الموثوق في نقل العفش</h3>
                    <p style="color:#dbe8f3">نحمي ممتلكاتك كأنها ممتلكاتنا، ونوصلها بأمان في الوقت المحدد.</p>
                    <a href="tel:@site.PhoneIntl" class="btn btn-cta btn-lg mt-2"><i class="fa-solid fa-phone-volume"></i> @site.Phone</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section bg-soft">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-6">
                <div class="mv-card">
                    <h4><i class="fa-solid fa-bullseye"></i> رسالتنا</h4>
                    <p class="mb-0">@a.Mission</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mv-card">
                    <h4><i class="fa-solid fa-eye"></i> رؤيتنا</h4>
                    <p class="mb-0">@a.Vision</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section bg-white">
    <div class="container">
        <div class="section-head">
            <span class="section-eyebrow">قيمنا</span>
            <h2>ما نؤمن به</h2>
        </div>
        <div class="row g-4">
            @foreach (var v in a.Values)
            {
                <div class="col-lg-3 col-sm-6">
                    <div class="value-card">
                        <div class="value-ico"><i class="fa-solid @v.Icon"></i></div>
                        <h4>@v.Title</h4>
                        <p style="color:var(--muted)">@v.Desc</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="cta-band">
    <div class="container">
        <h2>ابدأ نقل أثاثك اليوم</h2>
        <p>فريقنا جاهز لخدمتك على مدار الساعة</p>
        <a asp-controller="Contact" asp-action="Index" class="btn btn-dark-c btn-lg"><i class="fa-solid fa-headset"></i> تواصل معنا</a>
    </div>
</section>
