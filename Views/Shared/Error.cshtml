@model ErrorViewModel
@inject IContentRepository Repo
@{
    ViewData["Title"] = "حدث خطأ";
    ViewData["Robots"] = "noindex, nofollow";
    var site = Repo.Site;
}

<section class="page-hero">
    <div class="container">
        <h1>حدث خطأ غير متوقع</h1>
        <div class="breadcrumb-c">
            <a asp-controller="Home" asp-action="Index">الرئيسية</a> <span>/</span> <span>خطأ</span>
        </div>
    </div>
</section>

<section class="section bg-white">
    <div class="container text-center">
        <p class="lead">نعتذر، تعذّر إتمام طلبك. يمكنك المحاولة مرة أخرى أو التواصل معنا مباشرة وسنخدمك فوراً.</p>

        <div class="d-flex gap-2 justify-content-center flex-wrap mt-4">
            <a href="tel:@site.PhoneIntl" class="btn btn-cta btn-lg"><i class="fa-solid fa-phone-volume"></i> @site.Phone</a>
            <a href="https://wa.me/@site.Whatsapp" target="_blank" rel="noopener" class="btn btn-wa btn-lg"><i class="fa-brands fa-whatsapp"></i> واتساب</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-c btn-lg">العودة للرئيسية</a>
        </div>

        @if (Model.ShowRequestId)
        {
            <p class="text-muted small mt-4">رقم الطلب المرجعي: <code>@Model.RequestId</code></p>
        }
    </div>
</section>
