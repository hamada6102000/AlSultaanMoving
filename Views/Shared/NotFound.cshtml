@model SiteContent
@{
    // Rendered in place of the missing page by UseStatusCodePagesWithReExecute, so the
    // response keeps its 404/410 status. The view never changes the status code itself.
    var status = Context.Response.StatusCode;
    var missing = status is 404 or 410;

    ViewData["Title"] = missing ? "الصفحة غير موجودة" : "تعذّر عرض الصفحة";
    ViewData["Robots"] = "noindex, follow";
    var site = Model.Site;
}

<section class="page-hero">
    <div class="container">
        <div class="status-code" aria-hidden="true">@status</div>
        <h1>@(missing ? "عذراً، هذه الصفحة غير موجودة" : "عذراً، تعذّر عرض هذه الصفحة")</h1>
        <div class="breadcrumb-c">
            <a asp-controller="Home" asp-action="Index">الرئيسية</a> <span>/</span> <span>@ViewData["Title"]</span>
        </div>
    </div>
</section>

<section class="section bg-white">
    <div class="container text-center">
        <p class="lead">
            @(missing
                ? "ربما نُقلت الصفحة أو تغيّر رابطها. لا تقلق — فريقنا جاهز لخدمتك على مدار الساعة، اتصل بنا أو راسلنا على واتساب واحصل على عرض سعر مجاني."
                : "حدث خطأ أثناء معالجة طلبك. تواصل معنا مباشرة وسنخدمك فوراً.")
        </p>

        <div class="d-flex gap-2 justify-content-center flex-wrap mt-4">
            <a href="tel:@site.PhoneIntl" class="btn btn-cta btn-lg"><i class="fa-solid fa-phone-volume"></i> @site.Phone</a>
            <a href="https://wa.me/@site.Whatsapp" target="_blank" rel="noopener" class="btn btn-wa btn-lg"><i class="fa-brands fa-whatsapp"></i> واتساب</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-c btn-lg"><i class="fa-solid fa-house"></i> العودة للرئيسية</a>
        </div>

        <form asp-controller="Blog" asp-action="Index" method="get" class="row justify-content-center mt-5">
            <div class="col-md-6">
                <div class="input-group">
                    <input type="text" name="q" class="form-control" placeholder="ابحث في المقالات..." aria-label="ابحث في المقالات" />
                    <button class="btn btn-primary-b" type="submit"><i class="fa-solid fa-magnifying-glass"></i> بحث</button>
                </div>
            </div>
        </form>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-head">
            <span class="section-eyebrow">خدماتنا</span>
            <h2>ربما تبحث عن إحدى خدماتنا</h2>
            <p>اختر الخدمة التي تناسب احتياجك في @site.City</p>
        </div>

        <div class="row g-4">
            @foreach (var s in Model.Services)
            {
                <div class="col-lg-4 col-md-6">
                    <a asp-controller="Services" asp-action="Details" asp-route-slug="@s.Slug" class="service-card">
                        <div class="service-top">
                            <div class="s-ico"><i class="fa-solid @s.Icon"></i></div>
                            <h4>@s.Title</h4>
                        </div>
                        <div class="service-body">
                            <p>@s.Short</p>
                            <span class="more">تفاصيل الخدمة <i class="fa-solid fa-arrow-left"></i></span>
                        </div>
                    </a>
                </div>
            }
        </div>

        <div class="d-flex gap-2 justify-content-center flex-wrap mt-5">
            <a asp-controller="Blog" asp-action="Index" class="btn btn-outline-c">المدونة</a>
            <a asp-controller="Areas" asp-action="Index" class="btn btn-outline-c">مناطق الخدمة</a>
            <a asp-controller="Home" asp-action="About" class="btn btn-outline-c">من نحن</a>
            <a asp-controller="Contact" asp-action="Index" class="btn btn-outline-c">تواصل معنا</a>
        </div>
    </div>
</section>
